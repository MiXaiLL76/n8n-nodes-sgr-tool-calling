{
	"name": "n8n-nodes-sgr-tool-calling",
	"version": "0.1.8",
	"description": "n8n node for SGR AI Agent with Tool Calling capabilities and Tavily Search integration",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package",
		"sgr-tool-calling",
		"tool-calling",
		"sgr"
	],
	"author": {
		"name": "MiXaiLL76",
		"email": "mike.milos@yandex.ru"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/MiXaiLL76/sgr_tool_calling.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"build:prod": "n8n-node build && node scripts/obfuscate.js",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "npm run build:prod && n8n-node release",
		"prepublishOnly": "npm run build:prod && n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SgrApi.credentials.js",
			"dist/credentials/TavilyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SGR/SgrToolCalling.node.js",
			"dist/nodes/SGRTavilySearchTool/SgrTavilySearchTool.node.js",
			"dist/nodes/SGRCustomFinalAnswer/SgrCustomFinalAnswer.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"javascript-obfuscator": "^4.1.1",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
